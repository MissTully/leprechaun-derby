# Copy to .env for local dev, or set in Vercel → Settings → Environment Variables.
# Required: server-side ElevenLabs API key (never commit the real value).
ELEVENLABS_API_KEY=

# Optional: server-side default agent id. The game passes agent_id in the query,
# so this is not required.
# ELEVENLABS_AGENT_ID=agent_5201kz40jbs5epa8jkpcxyh391d2
